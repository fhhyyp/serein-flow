<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SereinFlow.TestLibrary</AssemblyName>
    <RootNamespace>SereinFlow.TestLibrary</RootNamespace>
    <Version>1.6.1</Version>
    <AssemblyVersion>1.6.1.0</AssemblyVersion>
    <FileVersion>1.6.1.0</FileVersion>
    <InformationalVersion>1.6.1</InformationalVersion>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- 节点方法采用实例类库形式，运行宿主执行节点时会创建对应的类型实例。 -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>

    <!-- API 接收“类库名-版本号.zip”格式的上传包；匹配 DLL 位于压缩包根目录下一层。 -->
    <TestLibraryPackageName>$(AssemblyName)-$(Version)</TestLibraryPackageName>
    <TestLibraryStagingRoot>$(BaseIntermediateOutputPath)test-library-package\</TestLibraryStagingRoot>
    <TestLibraryStagingDirectory>$(TestLibraryStagingRoot)$(TestLibraryPackageName)\</TestLibraryStagingDirectory>
    <TestLibraryArtifactDirectory>$(MSBuildProjectDirectory)\..\..\artifacts\libraries\</TestLibraryArtifactDirectory>
    <TestLibraryZipPath>$(TestLibraryArtifactDirectory)$(TestLibraryPackageName).zip</TestLibraryZipPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SereinFlow.Contracts\SereinFlow.Contracts.csproj" />
    <ProjectReference Include="..\..\src\SereinFlow.Runtime.Abstractions\SereinFlow.Runtime.Abstractions.csproj" />
  </ItemGroup>

  <Target Name="CreateTestLibraryUploadPackage" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(TestLibraryStagingRoot)" />
    <MakeDir Directories="$(TestLibraryStagingDirectory);$(TestLibraryArtifactDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TestLibraryStagingDirectory)" />
    <Delete Files="$(TestLibraryZipPath)" />
    <ZipDirectory
      SourceDirectory="$(TestLibraryStagingRoot)"
      DestinationFile="$(TestLibraryZipPath)"
      Overwrite="true" />
    <Message Importance="high" Text="SereinFlow 测试类库上传包：$(TestLibraryZipPath)" />
  </Target>

</Project>
