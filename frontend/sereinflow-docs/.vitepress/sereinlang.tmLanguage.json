{
  "name": "sereinlang",
  "displayName": "SereinScript",
  "scopeName": "source.sereinlang",
  "aliases": ["sereinscript"],
  "patterns": [
    {
      "name": "comment.line.double-slash.sereinlang",
      "begin": "//",
      "end": "$"
    },
    {
      "name": "comment.block.sereinlang",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.sereinlang",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.sereinlang",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "storage.type.sereinlang",
      "match": "\\b(?:let|var)\\b"
    },
    {
      "name": "keyword.control.sereinlang",
      "match": "\\b(?:if|then|else|when|for|in|return|import|from)\\b"
    },
    {
      "name": "constant.language.sereinlang",
      "match": "\\b(?:true|false|null)\\b"
    },
    {
      "name": "constant.numeric.sereinlang",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|[0-9]+(?:\\.[0-9]+)?)(?:[uU][lL]?|[lLfFdDmM])?\\b"
    },
    {
      "name": "entity.name.function.sereinlang",
      "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.sereinlang",
      "match": "=>|\\?\\.|==|!=|<=|>=|&&|\\|\\||[=+*/%<>!\\-]"
    },
    {
      "name": "punctuation.sereinlang",
      "match": "[{}()\\[\\],.;]"
    }
  ]
}
