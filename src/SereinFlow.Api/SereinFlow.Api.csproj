<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Update="mcp\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <ProjectReference Include="..\SereinFlow.Application\SereinFlow.Application.csproj" />
    <ProjectReference Include="..\SereinFlow.Contracts\SereinFlow.Contracts.csproj" />
    <ProjectReference Include="..\SereinFlow.Infrastructure\SereinFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\SereinFlow.Mcp\SereinFlow.Mcp.csproj" />
    <ProjectReference Include="..\SereinFlow.Worker.Client\SereinFlow.Worker.Client.csproj" />
  </ItemGroup>

  <Target Name="BuildWorkerRunner" BeforeTargets="Build">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\SereinFlow.Worker.Runner\SereinFlow.Worker.Runner.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
