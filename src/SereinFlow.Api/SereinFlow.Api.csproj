<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\SereinFlow.Mcp\Guidance\*.md" Link="mcp\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SereinFlow.AspNetCore\SereinFlow.AspNetCore.csproj" />
  </ItemGroup>

  <Target Name="BuildWorkerRunner" BeforeTargets="Build">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\SereinFlow.Worker.Runner\SereinFlow.Worker.Runner.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
