{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SereinFlow": {
    "DataRoot": "data",
    "DatabaseFileName": "sereinflow.db",
    "LibraryDirectoryName": "libraries",
    "ScriptArtifactDirectoryName": "script-artifacts",
    "McpStagingDirectoryName": "mcp-staging",
    "RunExecution": {
      "QueueCapacity": 100,
      "MaxConcurrentRuns": 4,
      "MaxConcurrentListenerRuns": 1,
      "MaxConcurrentRunsPerProject": 2,
      "QueueWaitTimeoutSeconds": 60,
      "ShutdownGracePeriodSeconds": 10
    },
    "Mcp": {
      "Http": {
        "MaxRequestBytes": 16777216,
        "MaxResponseBytes": 4194304,
        "MaxConcurrentRequests": 16,
        "MaxRequestsPerMinute": 120,
        "MaxToolExecutionSeconds": 60
      }
    }
  },
  "AllowedHosts": "*"
}
