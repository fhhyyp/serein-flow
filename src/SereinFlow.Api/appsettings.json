{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SereinFlow": {
    "DatabasePath": "data/sereinflow.db",
    "LibraryDirectory": "data/libraries",
    "RunExecution": {
      "QueueCapacity": 100,
      "MaxConcurrentRuns": 4,
      "MaxConcurrentListenerRuns": 1,
      "MaxConcurrentRunsPerProject": 2,
      "QueueWaitTimeoutSeconds": 60,
      "ShutdownGracePeriodSeconds": 10
    }
  },
  "AllowedHosts": "*"
}
