<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SereinFlow.Contracts\SereinFlow.Contracts.csproj" />
    <ProjectReference Include="..\SereinFlow.Runtime.Abstractions\SereinFlow.Runtime.Abstractions.csproj" />
    <ProjectReference Include="..\SereinFlow.ScriptModules\SereinFlow.ScriptModules.csproj" />
    <ProjectReference Include="$(SereinScriptRuntimeProject)" Condition="'$(SereinScriptRuntimeProject)' != ''" />
  </ItemGroup>

  <Target Name="ValidateSereinScriptSource" BeforeTargets="CoreCompile" Condition="'$(SereinScriptRuntimeProject)' == '' Or '$(SereinScriptGeneratorProject)' == '' Or !Exists('$(SereinScriptRuntimeProject)') Or !Exists('$(SereinScriptGeneratorProject)')">
    <Error Text="SereinScript source projects were not found. Set SereinScriptSourceRoot or SEREINFLOW_SEREINSCRIPT_SOURCE_ROOT to the SereinScript checkout root. 未找到 SereinScript 源码项目，请设置 SereinScriptSourceRoot 或 SEREINFLOW_SEREINSCRIPT_SOURCE_ROOT 为 SereinScript 源码根目录。" />
  </Target>

</Project>
