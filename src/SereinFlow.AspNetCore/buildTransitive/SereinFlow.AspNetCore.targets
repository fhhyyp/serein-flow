<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../worker/**/*"
             Link="sereinflow/worker/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>
</Project>
