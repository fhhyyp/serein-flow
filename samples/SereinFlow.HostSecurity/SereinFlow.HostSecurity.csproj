<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseSereinFlowPackage)' != 'true'">
    <ProjectReference Include="../../src/SereinFlow.AspNetCore/SereinFlow.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseSereinFlowPackage)' == 'true'">
    <PackageReference Include="SereinFlow.AspNetCore" VersionOverride="$(SereinFlowPackageVersion)" />
  </ItemGroup>
</Project>
